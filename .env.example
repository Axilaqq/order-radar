# Пример переменных. Реальные значения сюда НЕ пишем — они ставятся командой
#   npx wrangler secret put ИМЯ
# и живут в секретах Cloudflare.

SUPABASE_URL=https://<твой-проект>.supabase.co
SUPABASE_SERVICE_KEY=service_role_ключ_из_supabase
TELEGRAM_BOT_TOKEN=123456:AA...            # выдаёт @BotFather
TELEGRAM_CHAT_ID=123456789                 # твой личный chat_id
TELEGRAM_WEBHOOK_SECRET=длинная_случайная_строка
RUN_KEY=ещё_одна_случайная_строка          # защищает ручной запуск /run
